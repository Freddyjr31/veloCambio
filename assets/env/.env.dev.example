# Plantilla de entorno de DESARROLLO (comitear este archivo)
# Copia este archivo a `.env.dev` para usarlo:
#   cp assets/env/.env.dev.example assets/env/.env.dev
# (`.env.dev` esta ignorado por git; este ejemplo SI se commitea)

# Base URL del backend para desarrollo local.
# `10.0.2.2` es el loopback del emulador de Android hacia tu maquina.
# Para probar en un telefono fisico usa la IP de tu PC en la LAN, p.ej:
#   BASE_URL=http://192.168.1.50:9000/
BASE_URL=http://10.0.2.2:9000/

# Compilar para desarrollo:
#   flutter run --flavor dev
#   flutter build apk --debug --flavor dev
