# Plantilla de entorno de PRODUCCION (comitear este archivo)
# Copia este archivo a `.env.prod` para usarlo:
#   cp assets/env/.env.prod.example assets/env/.env.prod
# (`.env.prod` esta ignorado por git; este ejemplo SI se commitea)

# Base URL del backend en produccion (host base; la app concatena
# los endpoints: rates/usd_oficial, rates/usd_promedio, rates/eur, rates/usdt)
BASE_URL=https://velocambio-back.onrender.com/

# Compilar para produccion:
#   flutter build apk --release --flavor prod
