# VeloCambio - variables de entorno por flavor
# La app usa `--flavor dev|prod` y carga el archivo de entorno correspondiente:
#   dev  -> assets/env/.env.dev   (ver assets/env/.env.dev.example)
#   prod -> assets/env/.env.prod  (ver assets/env/.env.prod.example)
#
# Los archivos .env.dev / .env.prod reales estan ignorados por git.
# Copia el ejemplo correspondiente antes de compilar:
#   cp assets/env/.env.dev.example  assets/env/.env.dev
#   cp assets/env/.env.prod.example assets/env/.env.prod
#
# Compilacion:
#   Dev:  flutter run --flavor dev
#   Prod: flutter build apk --release --flavor prod

BASE_URL=
